---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const mailtoSubject = 'Filter inquiry';
const mailtoBody = [
  'SKU or OE number:',
  'Drawing or sample:',
  'Target quantity:',
  'Media / efficiency / packaging requirements:',
].join('\n');
---

<BaseLayout
  title="Contact"
  description="Contact China Filter Hub — Qinghe County Huiying Automotive Parts Co., Ltd. — for filter inquiries, OEM and private-label requests."
  breadcrumbs={[{ label: 'Contact', href: '/contact/' }]}
>
  <main class="wrap" style="padding-top:2rem;max-width:720px;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Contact</nav>
    <h1>Contact</h1>

    <p class="lede">
      Send an inquiry with the SKU or OE number, or a drawing and target quantity. MOQ and lead
      time are quoted per line; indicative pricing is confirmed on quotation.
    </p>

    <section>
      <h2>What to include in an inquiry</h2>
      <ul>
        <li>SKU or OE number, or a drawing and target quantity.</li>
        <li>Media, efficiency and packaging requirements if known.</li>
        <li>For OEM/private-label work, the branding and marking requirement.</li>
      </ul>
    </section>

    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr><th scope="col">Channel</th><th scope="col">Value</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>Email</strong></td><td><code>{site.entity.email}</code> · <code>{site.entity.emailAlt}</code></td></tr>
          <tr><td><strong>Phone / WhatsApp</strong></td><td><code>{site.entity.phone}</code></td></tr>
          <tr><td><strong>Address</strong></td><td><code>{site.entity.address}</code></td></tr>
        </tbody>
      </table>
    </div>

    <p style="margin-top:1rem;">
      <a class="btn btn-primary" href={`mailto:${site.entity.email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`}>
        Email an inquiry →
      </a>
      <a class="btn wa-btn" href={site.entity.whatsappLink} target="_blank" rel="noopener" style="margin-left:0.6rem;">💬 Chat on WhatsApp Now</a>
    </p>

    <p class="notice" style="margin-top:1rem;">
      Contact channels belong to the operating legal entity, Qinghe County Huiying Automotive
      Parts Co., Ltd. — the same entity behind carfilterspro.com.
    </p>
  </main>
</BaseLayout>
