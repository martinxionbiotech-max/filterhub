---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pillars } from '../../data/pillars';
import { getSeriesList } from '../../lib/knowledge';
import { buildKnowledgeSeriesCards } from '../../data/knowledge-series';

const breadcrumbs = [{ label: 'Pillars', href: '/pillars/' }];
const knowledgeSeriesCards = buildKnowledgeSeriesCards(await getSeriesList());
---

<BaseLayout
  title="Content Pillars"
  description="Five content pillars of China Filter Hub — automotive filters, filter technology, industrial and HVAC filtration, OEM and wholesale sourcing, and manufacturing."
  breadcrumbs={breadcrumbs}
>
  <main id="main" class="wrap" style="padding-top:2rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Pillars</nav>
    <h1>Content Pillars</h1>
    <p class="lede" style="max-width:70ch;">
      The site is organised into five pillars that connect product selection, technical
      understanding and manufacturing supply into one sourcing decision chain.
    </p>

    <div class="grid grid--cards" style="margin-top:1.75rem;">
      {pillars.map((p) => (
        <a class="card card--link" href={`/pillars/${p.slug}/`}>
          <p class="eyebrow" style="margin:0 0 0.3rem;">{p.shortName}</p>
          <strong style="color:var(--navy-800);">{p.name}</strong>
          <p class="muted small" style="margin:0.45rem 0 0;">{p.positioning}</p>
        </a>
      ))}
    </div>

    <section class="section" style="margin-top:2rem;">
      <h2 class="mt-0">Technical knowledge base</h2>
      <p class="muted" style="max-width:70ch;">Four series of in-depth technical articles that sit behind the commercial pillars — written for buyers and quality engineers rather than as marketing copy.</p>
      <div class="grid grid--cards" style="margin-top:1rem;">
        {knowledgeSeriesCards.map((series) => (
          <a class="card card--link" href={series.href}>
            <p class="eyebrow" style="margin:0 0 0.3rem;">{series.count} articles</p>
            <strong style="color:var(--navy-800);">{series.title}</strong>
            <span class="muted small" style="display:block;margin-top:0.25rem;">{series.description}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
