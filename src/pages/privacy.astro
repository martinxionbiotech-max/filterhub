---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for the China Filter Hub website — a product information and database hub."
  breadcrumbs={[{ label: 'Privacy Policy', href: '/privacy/' }]}
>
  <main class="wrap" style="padding-top:2rem;max-width:760px;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Privacy Policy</nav>
    <h1>Privacy Policy</h1>
    <p>
      This site collects only the information you provide through inquiry or contact. It does not
      use third-party advertising trackers. Inquiry details are used solely to respond to your
      request.
    </p>
    <p>
      Contact channels are provisional pending domain and entity verification. For data requests,
      use the contact channels listed on the contact page.
    </p>
  </main>
</BaseLayout>
