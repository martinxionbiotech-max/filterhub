---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cookie Policy"
  description="Cookie policy for the China Filter Hub website — a product information and database hub."
  breadcrumbs={[{ label: 'Cookie Policy', href: '/cookies/' }]}
>
  <main class="wrap" style="padding-top:2rem;max-width:760px;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Cookie Policy</nav>
    <h1>Cookie Policy</h1>
    <p>
      This site does not use advertising or tracking cookies. Any cookies are limited to those
      necessary for basic site function.
    </p>
  </main>
</BaseLayout>
