---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';

// Group guides by pillar, preserving the order pillars first appear in.
const pillarOrder: string[] = [];
for (const g of guides) {
  if (!pillarOrder.includes(g.pillar)) pillarOrder.push(g.pillar);
}

const breadcrumbs = [{ label: 'Buyer Guides', href: '/guides/' }];
---

<BaseLayout
  title="Buyer Guides"
  description="Practical procurement guides for filter selection and cleanroom sourcing, drawn from a consolidated filter catalogue."
  breadcrumbs={breadcrumbs}
>
  <main class="wrap" style="padding-top:2rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Buyer Guides</nav>
    <h1>Buyer Guides</h1>
    <p class="lede" style="max-width:70ch;">
      Procurement guides that walk through selection criteria, efficiency-grade frameworks and
      what to verify before ordering.
    </p>

    {pillarOrder.map((pillar) => {
      const group = guides.filter((g) => g.pillar === pillar);
      return (
        <section class="section">
          <div class="section-head">
            <h2 class="mt-0">{pillar}</h2>
            <p class="muted small">{group.length} guide{group.length === 1 ? '' : 's'}</p>
          </div>
          <div class="grid grid--cards">
            {group.map((g) => (
              <a class="card card--link" href={`/guides/${g.slug}/`}>
                <p class="eyebrow" style="margin:0 0 0.3rem;">{g.pillar}</p>
                <strong style="color:var(--navy-800);">{g.title}</strong>
                <p class="muted small" style="margin:0.45rem 0 0;">{g.description}</p>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>
