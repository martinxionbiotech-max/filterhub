---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides, type Guide } from '../../data/guides';
import { categories } from '../../data/categories';
import { guideCategories, guideSkus, guideCommercialLinks } from '../../data/link-map';
import { productBySlug, categorySlug, skuSlug } from '../../data/products';
import { pillarForGuide } from '../../data/pillars';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props as { guide: Guide };

// Section bodies come from src/data/guides.ts as lightweight markdown (a table,
// a bullet list, occasional bold). The template used to print them as plain text,
// so a table rendered as literal pipes. This renders the three constructs the data
// actually uses, escaping everything else.
function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function renderBody(body: string): string {
  const inline = (line: string): string =>
    escapeHtml(line)
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

  const lines = body.split('\n');
  const html: string[] = [];
  let i = 0;

  while (i < lines.length) {
    const line = lines[i].trim();

    if (!line) { i += 1; continue; }

    // markdown table: header row, separator row, body rows
    if (line.startsWith('|') && lines[i + 1]?.trim().match(/^\|[-:\s|]+\|$/)) {
      const cells = (row: string): string[] =>
        row.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map((c) => c.trim());
      const head = cells(line);
      i += 2;
      const rows: string[][] = [];
      while (i < lines.length && lines[i].trim().startsWith('|')) {
        rows.push(cells(lines[i]));
        i += 1;
      }
      html.push(
        '<div class="table-wrap"><table class="data"><thead><tr>' +
          head.map((h) => `<th scope="col">${inline(h)}</th>`).join('') +
          '</tr></thead><tbody>' +
          rows.map((r) => '<tr>' + r.map((c) => `<td>${inline(c)}</td>`).join('') + '</tr>').join('') +
          '</tbody></table></div>',
      );
      continue;
    }

    // bullet list
    if (/^[-*]\s+/.test(line)) {
      const items: string[] = [];
      while (i < lines.length && /^[-*]\s+/.test(lines[i].trim())) {
        items.push(`<li>${inline(lines[i].trim().replace(/^[-*]\s+/, ''))}</li>`);
        i += 1;
      }
      html.push(`<ul>${items.join('')}</ul>`);
      continue;
    }

    // paragraph (join until blank line)
    const para: string[] = [];
    while (i < lines.length && lines[i].trim() && !lines[i].trim().startsWith('|') && !/^[-*]\s+/.test(lines[i].trim())) {
      para.push(lines[i].trim());
      i += 1;
    }
    html.push(`<p>${inline(para.join(' '))}</p>`);
  }

  return html.join('\n');
}

const relatedCategories = (guideCategories[guide.slug] ?? [])
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter(Boolean);

// Featured SKUs (top models) resolved to full catalogue records.
const featuredSkus = (guideSkus[guide.slug] ?? [])
  .map((sku) => productBySlug(sku))
  .filter(Boolean);

const commercialLinks = guideCommercialLinks[guide.slug] ?? [];
const pillar = pillarForGuide(guide.slug);

const breadcrumbs = [
  { label: 'Buyer Guides', href: '/guides/' },
  { label: guide.title, href: `/guides/${guide.slug}/` },
];

// Stable anchors for section headings (used for the in-page table of contents).
function anchor(text: string): string {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}

const tocItems = [
  { id: 'key-takeaway', label: 'Key takeaway' },
  ...guide.sections.map((s) => ({ id: anchor(s.heading), label: s.heading })),
  { id: 'sourcing-perspective', label: 'From a sourcing perspective' },
  ...(guide.related.length > 0 ? [{ id: 'related-guides', label: 'Related guides' }] : []),
  ...(relatedCategories.length > 0 ? [{ id: 'related-categories', label: 'Shop the category' }] : []),
  ...(featuredSkus.length > 0 ? [{ id: 'featured-skus', label: 'Featured SKUs' }] : []),
  { id: 'sources', label: 'Sources' },
];

// Article schema with entity associations: standard entities (EN 1822 / ISO 16890
// etc.) and the pillar/cluster as `about`, so body and structured data stay in sync.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  mainEntityOfPage: `https://chinafilterhub.com/guides/${guide.slug}/`,
  publisher: { '@id': 'https://chinafilterhub.com/#organization' },
  inLanguage: 'en',
  articleSection: guide.pillar,
  about: [
    ...(guide.standards.length > 0 ? guide.standards.map((s) => ({ '@type': 'Thing', name: s })) : []),
    { '@type': 'Thing', name: guide.pillar },
  ],
};
---

<BaseLayout title={guide.metaTitle ?? guide.title} description={guide.description} breadcrumbs={breadcrumbs}>
  <main id="main" class="wrap" style="padding-top:2rem;max-width:780px;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/guides/">Buyer Guides</a> / {guide.title}
    </nav>
    <h1>{guide.title}</h1>
    <p class="eyebrow">{guide.pillar}</p>
    <p class="lede">{guide.directAnswer}</p>

    <nav class="toc" aria-label="On this page">
      <strong>On this page</strong>
      <ol>
        {tocItems.map((t) => (
          <li><a href={`#${t.id}`}>{t.label}</a></li>
        ))}
      </ol>
    </nav>

    <section id="key-takeaway" class="notice notice--navy" style="margin-top:1.5rem;">
      <strong>Key takeaway — </strong>{guide.keyTakeaway}
    </section>

    {guide.sections.map((s) => (
      <section id={anchor(s.heading)}>
        <h2>{s.heading}</h2>
        <div class="guide-body" set:html={renderBody(s.body)} />
      </section>
    ))}

    <section id="sourcing-perspective">
      <h2>From a sourcing perspective</h2>
      <p>{guide.sourcingPerspective}</p>
    </section>

    {guide.related.length > 0 && (
      <section id="related-guides">
        <h2>Related guides</h2>
        <ul>
          {guide.related.map((slug) => {
            const g = guides.find((x) => x.slug === slug);
            return g ? (
              <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
            ) : null;
          })}
        </ul>
      </section>
    )}

    {relatedCategories.length > 0 && (
      <section id="related-categories">
        <h2>Shop the category</h2>
        <ul>
          {relatedCategories.map((c) => (
            <li><a href={`/products/${c!.slug}/`}>{c!.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    {featuredSkus.length > 0 && (
      <section id="featured-skus">
        <h2>Featured SKUs</h2>
        <ul>
          {featuredSkus.map((p) => {
            const catSlug = categorySlug(p!.category);
            return (
              <li>
                <a href={`/products/${catSlug}/${skuSlug(p!.url_slug || p!.sku)}/`}>
                  <code>{p!.sku}</code> — {p!.name}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {commercialLinks.length > 0 && (
      <section>
        <h2>Related pages</h2>
        <ul>
          {commercialLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    {pillar && (
      <section id="related-pillar">
        <div class="pillar-cta">
          <h2 style="color:#fff;">{pillar.name}</h2>
          <p style="color:#c4d3e2;max-width:60ch;">{pillar.positioning}</p>
          <p style="margin:0;">
            <a class="btn btn-primary" href={`/pillars/${pillar.slug}/`} style="background:#fff;color:var(--navy-800);">Explore the {pillar.shortName} pillar →</a>
          </p>
        </div>
      </section>
    )}

    <section id="sources">
      <h2>Sources</h2>
      <ul>
        {guide.sources.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </main>
</BaseLayout>

<style>
  .pillar-cta {
    background: linear-gradient(160deg, var(--navy-900) 0%, var(--navy-700) 100%);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.6rem;
    color: #eaf1f7;
  }
  .pillar-cta h2 { color: #fff; }
  .pillar-cta p { margin: 0 0 1em; }
</style>
