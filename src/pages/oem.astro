---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const mailtoSubject = 'RFQ — filter inquiry';
const mailtoBody = [
  'SKU or OE number:',
  'Drawing or sample:',
  'Target quantity:',
  'Media / efficiency / packaging requirements:',
].join('\n');
---

<BaseLayout
  title="OEM & Private Label"
  description="OEM and ODM manufacturing for standard and custom filter sizes — prototyping, private-label packaging, MOQ, lead time and inquiry guidance."
  breadcrumbs={[{ label: 'OEM / Private Label', href: '/oem/' }]}
>
  <main id="main" class="wrap" style="padding-top:2rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / OEM / Private Label</nav>
    <h1>OEM &amp; Private Label</h1>

    <p class="lede" style="max-width:70ch;">
      OEM and ODM manufacturing is supported for standard and custom sizes, from prototyping through
      to production, including filter media at low minimum order quantities.
    </p>

    <section>
      <h2>What can be customised</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Dimension</th><th scope="col">Options</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Dimensions</strong></td><td>Standard and custom sizes across panel, round, heavy-duty and HEPA forms.</td></tr>
            <tr><td><strong>Media</strong></td><td>Synthetic fibre, micro-glass, activated carbon and needle-punched media.</td></tr>
            <tr><td><strong>Frames and seals</strong></td><td>Aluminium, galvanised steel, stainless; gel, gasket and endless-gasket seals.</td></tr>
            <tr><td><strong>Efficiency grade</strong></td><td>Matched to the application from G1 through U17.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Process</h2>
      <ol>
        <li>Send a drawing, sample or OE number with target quantity.</li>
        <li>Confirm media, frame, seal and efficiency specification.</li>
        <li>Prototype approval where required.</li>
        <li>Production with pre-shipment quality check.</li>
      </ol>
    </section>

    <section>
      <h2>Sampling and prototyping</h2>
      <p>
        For custom or OE-matched work, the sequence is sample-first: confirm the specification, produce
        a prototype or first article, and submit it against the OE drawing for approval before serial
        production. The approved sample is put on file as the reference for every subsequent batch.
      </p>
    </section>

    <section>
      <h2>Private label and packaging</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Condition</th><th scope="col">Options</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Branding</strong></td><td>Your own brand or neutral (unbranded) marking.</td></tr>
            <tr><td><strong>Packaging</strong></td><td>Plain carton, retail box, polybag or custom-printed packaging.</td></tr>
            <tr><td><strong>Labelling</strong></td><td>Barcode, part number and logo per your artwork.</td></tr>
            <tr><td><strong>Marking</strong></td><td>Multi-SKU runs supported across standard and custom sizes.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>MOQ and lead time</h2>
      <p>
        MOQ and lead time are quoted per line. Standard sizes ship faster; custom sizes and
        private-label packaging add lead time. Filter media is available at a low minimum order
        quantity, which makes this a prototyping-to-production bridge for integrators.
      </p>
    </section>

    <section>
      <h2>Before you inquire</h2>
      <p class="muted">
        Three short reads that make the first conversation more productive — how a supplier is
        screened, how a first article is accepted, and what a quality agreement should cover.
      </p>
      <ul>
        <li>
          <a href="/knowledge/filter-supplier-selection/">How to choose and control a filter supplier</a>
          — screening, factory audit and production risk.
        </li>
        <li>
          <a href="/knowledge/filter-first-article-inspection/">First article inspection for filters</a>
          — acceptance criteria and the documents to request.
        </li>
        <li>
          <a href="/knowledge/filter-quality-agreement/">What belongs in a filter quality agreement</a>
          — the clauses that decide who pays when a batch fails.
        </li>
        <li>
          <a href="/guides/oem-procurement-process/">Automotive filter OEM manufacturing guide</a>
          — the commercial route from RFQ to first article.
        </li>
      </ul>
    </section>

    <section>
      <h2>Start an inquiry</h2>
      <p>
        Send the SKU or OE number, a drawing or sample, and a target quantity. We respond with an
        MOQ, lead-time and price indication per line.
      </p>
      <p style="margin-top:1rem;">
        <a class="btn btn-primary" href="/rfq/">Submit an RFQ →</a>
        <a class="btn btn-ghost" href="/private-label/" style="margin-left:0.5rem;">Private label</a>
        <a class="btn btn-ghost" href="/wholesale/" style="margin-left:0.5rem;">Wholesale &amp; distribution</a>
      </p>
      <p class="muted small" style="margin-top:0.75rem;">
        Prefer email?{' '}
        <a href={`mailto:${site.entity.email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`}>
          Email an inquiry
        </a>{' '}
        or see the <a href="/contact/">contact page</a> for the current channels.
      </p>
    </section>
  </main>
</BaseLayout>
