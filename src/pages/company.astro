---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Company"
  description="Legal-entity disclosure for China Filter Hub — operated by Qinghe County Huiying Automotive Parts Co., Ltd., registered in Qinghe County, Hebei, China."
  breadcrumbs={[{ label: 'Company', href: '/company/' }]}
>
  <main class="wrap" style="padding-top:2rem;max-width:780px;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Company</nav>
    <h1>Company</h1>

    <p class="lede" style="max-width:70ch;">
      China Filter Hub is a product information and database hub operated by a single legal
      entity, disclosed in full below. This page keeps the entity disclosure concise; the full
      company story, factory details and history live on the primary storefront.
    </p>

    <section>
      <h2>Legal entity</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Field</th><th scope="col">Value</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Legal name</strong></td><td>{site.entity.legalName}</td></tr>
            <tr><td><strong>Chinese name</strong></td><td>{site.entity.legalNameZh}</td></tr>
            <tr><td><strong>Unified social credit code</strong></td><td><code>{site.entity.creditCode}</code></td></tr>
            <tr><td><strong>Legal representative</strong></td><td>{site.entity.legalRepresentative}</td></tr>
            <tr><td><strong>Incorporated</strong></td><td>10 October 2017</td></tr>
            <tr><td><strong>Registered address</strong></td><td>{site.entity.address}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted small" style="margin-top:0.75rem;">
        Registration facts sourced from a Tianyancha snapshot (aggregated via Sogou, retrieved
        2026-10-25).{' '}
        <a href={site.baikeUrl} rel="noopener" target="_blank">Company profile on Baidu Baike</a>{' '}
        (region-blocked on crawl; URL cited as the authoritative reference).
      </p>
    </section>

    <section>
      <h2>Brand and lineage</h2>
      <p>{site.brandRelationship}. The Huiying brand name has been used in Qinghe County&rsquo;s filter
      industry since {site.entity.since}. The legal company that operates this site was incorporated on
      10 October 2017 &mdash; a later formalisation of the same filter business.</p>
    </section>

    <section>
      <h2>Contact</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th scope="col">Channel</th><th scope="col">Value</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Email</strong></td><td><code>{site.entity.email}</code></td></tr>
            <tr><td><strong>Phone / WhatsApp</strong></td><td><code>{site.entity.phone}</code></td></tr>
            <tr><td><strong>Address</strong></td><td><code>{site.entity.address}</code></td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted small" style="margin-top:0.75rem;">
        Contact channels are confirmed at the <a href="/contact/">contact page</a>.
      </p>
    </section>

    <section>
      <h2>Full company profile</h2>
      <p class="notice">
        For the full company profile, factory details, equipment, history and production figures,
        see{' '}
        <a href={site.companyProfileUrl} rel="noopener" target="_blank">
          carfilterspro.com/company-profile/
        </a>{' '}
        — the primary storefront of the same legal entity.
      </p>
    </section>
  </main>
</BaseLayout>
