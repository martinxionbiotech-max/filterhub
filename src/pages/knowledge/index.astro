---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesList, readingMinutes } from '../../lib/knowledge';

const seriesList = await getSeriesList();

const seriesIntros: Record<string, string> = {
  'air-filter-performance':
    'A framework for comparing efficiency, pressure drop, dust loading, airflow and service life before an air filter is selected.',
  'filter-quality-verification':
    'A procurement and quality-engineering workflow for standards, test reports, samples, production batches and corrective action.',
  'oem-supplier-risk':
    'A control sequence for screening suppliers, auditing factories and governing tooling, production, change, commercial and documentation risk.',
};

const clusterCount = seriesList.reduce((total, series) => total + series.clusters.length, 0);

const breadcrumbs = [{ label: 'Knowledge', href: '/knowledge/' }];
---

<BaseLayout
  title="Filter Knowledge Base"
  description="Technical procurement guides for air filter performance, supplier screening, factory audits, first-article approval and batch consistency."
  breadcrumbs={breadcrumbs}
>
  <main id="main" class="wrap knowledge-index">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / Knowledge
    </nav>

    <header class="knowledge-index-head">
      <p class="eyebrow">Technical knowledge base</p>
      <h1>Filter knowledge for buyers and engineers</h1>
      <p class="lede">
        Filter selection, supplier qualification and filter verification are separate decisions. This
        library covers the performance relationships that determine lifecycle value, the evidence a buyer
        should require before approving a supplier, sample or production batch, and the controls that keep
        that approval intact after production starts.
      </p>
      <p class="muted small">
        {seriesList.length} series · {seriesList.length} pillars · {clusterCount} in-depth guides
      </p>
    </header>

    {seriesList.map((series, seriesIndex) => (
      <section class="section knowledge-series-section" aria-labelledby={`series-${series.slug}-heading`}>
        <div class="section-head knowledge-series-head">
          <div>
            <p class="eyebrow">Series {String(seriesIndex + 1).padStart(2, '0')}</p>
            <h2 id={`series-${series.slug}-heading`} class="mt-0">{series.title}</h2>
          </div>
          <p class="muted knowledge-series-intro">
            {seriesIntros[series.slug] ?? series.clusters[0]?.data.description ?? 'A structured technical series.'}
          </p>
        </div>

        <a class="card card--link knowledge-pillar-card" href={`/knowledge/${series.pillar.data.slug}/`}>
          <div>
            <p class="eyebrow" style="margin:0 0 0.35rem;">Pillar</p>
            <h3 class="mt-0">{series.pillar.data.title}</h3>
            <p class="muted">{series.pillar.data.description}</p>
          </div>
          <span class="knowledge-read-time">≈ {readingMinutes(series.pillar.body ?? '')} min read</span>
        </a>

        <p class="knowledge-series-label">Series articles</p>
        <div class="grid grid--cards">
          {series.clusters.map((entry) => (
            <a class="card card--link knowledge-series-card" href={`/knowledge/${entry.data.slug}/`}>
              <p class="eyebrow" style="margin:0 0 0.35rem;">Part {entry.data.order}</p>
              <h3>{entry.data.title}</h3>
              <p class="muted small">{entry.data.description}</p>
              <span class="knowledge-read-time">≈ {readingMinutes(entry.body ?? '')} min read</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .knowledge-index { padding-top: 2rem; }
  .knowledge-index-head { max-width: 820px; margin: 1.25rem 0 2.5rem; }
  .knowledge-index-head h1 { margin: 0.3rem 0 0.85rem; }
  .knowledge-series-section { margin-top: 3.5rem; }
  .knowledge-series-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: end;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .knowledge-series-head h2 { margin-bottom: 0; }
  .knowledge-series-intro { margin: 0; }
  .knowledge-series-label {
    margin: 2rem 0 0.85rem;
    color: var(--navy-700);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .knowledge-pillar-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem;
    border-left: 4px solid var(--orange-600);
  }
  .knowledge-pillar-card h3 { color: var(--navy-800); margin-bottom: 0.55rem; }
  .knowledge-pillar-card p:last-child { margin-bottom: 0; }
  .knowledge-series-card { display: flex; flex-direction: column; }
  .knowledge-series-card h3 {
    color: var(--navy-800);
    font-size: 1.05rem;
    line-height: 1.4;
    margin: 0 0 0.6rem;
  }
  .knowledge-series-card p { flex: 1; }
  .knowledge-read-time {
    display: inline-block;
    margin-top: 0.85rem;
    color: var(--orange-700);
    font-size: var(--fs-xs);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .knowledge-series-head { grid-template-columns: 1fr; gap: 0.75rem; }
    .knowledge-pillar-card { flex-direction: column; }
  }
</style>
