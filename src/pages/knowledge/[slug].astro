---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import {
  getKnowledgeEntries,
  knowledgeCategorySlugs,
  readingMinutes,
  entryEyebrow,
  type KnowledgeEntry,
} from '../../lib/knowledge';
import { standardsIn } from '../../data/standard-links';

export async function getStaticPaths() {
  const entries = await getKnowledgeEntries();
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: KnowledgeEntry };
const entries = await getKnowledgeEntries();
const { Content, headings } = await render(entry);

const isPillar = entry.data.isPillar;
const seriesEntries = entries.filter((item) => item.data.series === entry.data.series);
const clusters = seriesEntries
  .filter((item) => !item.data.isPillar)
  .sort((a, b) => a.data.order - b.data.order);
const pillar = seriesEntries.find(
  (item) => item.data.isPillar && item.data.slug === entry.data.pillarSlug,
);
const adjacentEntries = clusters.filter(
  (item) => Math.abs(item.data.order - entry.data.order) === 1,
);
const relatedEntries = isPillar
  ? clusters
  : [pillar, ...adjacentEntries].filter((item): item is KnowledgeEntry => Boolean(item));
const tocItems = headings.filter((heading) => heading.depth === 2);
const canonical = `https://chinafilterhub.com/knowledge/${entry.data.slug}/`;
const published = entry.data.published.toISOString().slice(0, 10);

const relatedCategories = knowledgeCategorySlugs
  .map((slug) => categories.find((category) => category.slug === slug))
  .filter((category): category is NonNullable<typeof category> => Boolean(category));

const breadcrumbs = [
  { label: 'Knowledge', href: '/knowledge/' },
  { label: entry.data.title, href: `/knowledge/${entry.data.slug}/` },
];

// FAQPage for the question-style H2 sections. Only pairs whose first paragraph reads
// as an answer survive: short preambles ("Before discussing ...") and one-line stubs
// make low-quality FAQ markup, so they are dropped rather than padded.
function buildFaq(body: string | undefined): { q: string; a: string }[] {
  if (!body) return [];
  const weak = /^(before discussing|this section|to understand|in this section|the next|consider two)/i;
  const lines = body.split('\n');
  const pairs: { q: string; a: string }[] = [];
  for (let i = 0; i < lines.length; i += 1) {
    const heading = lines[i].trim();
    if (!/^##\s+.+\?\s*$/.test(heading)) continue;
    let answer = '';
    for (let j = i + 1; j < Math.min(i + 10, lines.length); j += 1) {
      const line = lines[j].trim();
      if (!line || line.startsWith('#') || line.startsWith('|') || line.startsWith('-')) continue;
      answer = line;
      break;
    }
    answer = answer
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*_`]/g, '')
      .trim();
    // take the first two sentences
    const sentences = answer.match(/[^.!?]+[.!?]+/g);
    if (sentences) answer = sentences.slice(0, 2).join(' ').trim();
    if (answer.length < 110 || weak.test(answer)) continue;
    const question = heading.replace(/^##\s+/, '').replace(/^\d+\.\s*/, '').trim();
    pairs.push({ q: question, a: answer });
    if (pairs.length === 6) break;
  }
  return pairs;
}

const citedStandards = standardsIn(entry.body);
const faqPairs = buildFaq(entry.body);
const faqSchema = faqPairs.length >= 2
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqPairs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  mainEntityOfPage: canonical,
  datePublished: published,
  dateModified: published,
  publisher: { '@id': 'https://chinafilterhub.com/#organization' },
  inLanguage: 'en',
  articleSection: entry.data.seriesTitle,
  isPartOf: {
    '@type': 'CollectionPage',
    name: entry.data.seriesTitle,
    url: 'https://chinafilterhub.com/knowledge/',
  },
};
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
>
  <main id="main" class="wrap knowledge-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/knowledge/">Knowledge</a> / {entry.data.title}
    </nav>

    <header class="knowledge-header">
      <p class="eyebrow">{entryEyebrow(entry)}</p>
      <h1>{entry.data.title}</h1>
      <p class="muted small">≈ {readingMinutes(entry.body ?? '')} min read</p>
    </header>

    {tocItems.length > 0 && (
      <nav class="toc knowledge-toc" aria-label="On this page">
        <strong>On this page</strong>
        <ol>
          {tocItems.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <article class="knowledge-body">
      <Content />
    </article>

    {citedStandards.length > 0 && (
      <section class="section" aria-labelledby="standards-heading">
        <h2 id="standards-heading" class="mt-0">Standards referenced</h2>
        <p class="muted small" style="max-width:70ch;">
          Each title links to the issuing body's catalogue page so the source can be checked
          at origin. The standard text is not reproduced here, and the page is not a
          substitute for the document itself.
        </p>
        <ul>
          {citedStandards.map((ref) => (
            <li>
              {ref.url ? (
                <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}</a>
              ) : (
                <span>{ref.label}</span>
              )}
              {' '}<span class="muted small">— {ref.issuer}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section class="section knowledge-related" aria-labelledby="related-heading">
        <div class="section-head">
          <h2 id="related-heading" class="mt-0">Related</h2>
          <p class="muted small">
            {isPillar ? 'Continue with the series' : 'Return to the framework or move to an adjacent part'}
          </p>
        </div>
        <div class="grid grid--cards">
          {relatedEntries.map((item) => (
            <a class="card card--link" href={`/knowledge/${item.data.slug}/`}>
              <p class="eyebrow" style="margin:0 0 0.35rem;">
                {item.data.isPillar ? 'Pillar' : `Part ${item.data.order}`}
              </p>
              <strong style="color:var(--navy-800);">{item.data.title}</strong>
              <p class="muted small" style="margin:0.5rem 0 0;">{item.data.description}</p>
              <span class="knowledge-card-meta">≈ {readingMinutes(item.body ?? '')} min read</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section knowledge-categories" aria-labelledby="categories-heading">
      <div class="section-head">
        <h2 id="categories-heading" class="mt-0">Related product categories</h2>
        <a class="muted small" href="/products/">Browse all filter categories →</a>
      </div>
      <div class="grid grid--cards">
        {relatedCategories.map((category) => (
          <a class="card card--link knowledge-category-card" href={`/products/${category.slug}/`}>
            <strong>{category.name}</strong>
            <p class="muted small">{category.summary}</p>
            <span class="knowledge-card-meta">Explore category →</span>
          </a>
        ))}
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </main>
</BaseLayout>

<style>
  .knowledge-page { padding-top: 2rem; }
  .knowledge-header { max-width: 820px; margin: 1.35rem 0 1.5rem; }
  .knowledge-header h1 { margin: 0.35rem 0 0.65rem; }
  .knowledge-header .small { margin: 0; }
  .knowledge-toc { max-width: 820px; margin-bottom: 2.25rem; }
  .knowledge-toc ol { columns: 2; column-gap: 2rem; }
  .knowledge-body { max-width: 820px; }
  .knowledge-body :global(p) { margin: 0 0 1.15rem; line-height: 1.75; }
  .knowledge-body :global(h2) {
    margin: 2.6rem 0 1rem;
    padding-top: 0.25rem;
    scroll-margin-top: 6rem;
  }
  .knowledge-body :global(h3) {
    margin: 1.9rem 0 0.75rem;
    color: var(--navy-800);
    scroll-margin-top: 6rem;
  }
  .knowledge-body :global(ul),
  .knowledge-body :global(ol) { margin: 0 0 1.3rem; padding-left: 1.4rem; }
  .knowledge-body :global(li) { margin: 0.35rem 0; line-height: 1.65; }
  .knowledge-body :global(a) { color: var(--navy-700); text-decoration-color: var(--orange-500); text-underline-offset: 2px; }
  .knowledge-body :global(a:hover) { color: var(--orange-700); }
  .knowledge-body :global(.table-wrap) { margin: 1.5rem 0; }
  .knowledge-body :global(.katex-display) {
    margin: 1.4rem 0;
    padding: 0.65rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .knowledge-body :global(p.small) { font-size: var(--fs-sm); line-height: 1.65; }
  .knowledge-body :global(p.small > a) { font-weight: 600; }
  .knowledge-related { max-width: 820px; }
  .knowledge-categories { max-width: 820px; }
  .knowledge-category-card { display: flex; flex-direction: column; }
  .knowledge-category-card p { flex: 1; }
  .knowledge-card-meta {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--orange-700);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  @media (max-width: 720px) {
    .knowledge-toc ol { columns: 1; }
  }
</style>
