---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { site } from '../../../data/site';
import { guides } from '../../../data/guides';
import { categoryGuides } from '../../../data/link-map';
import { skuDepth } from '../../../data/sku-depth';
import {
  products,
  categorySlug,
  categoryName,
  skuSlug,
  type Product,
} from '../../../data/products';
import { pillarForCategory, isAutomotiveCategory } from '../../../data/pillars';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { category: categorySlug(p.category), slug: skuSlug(p.url_slug || p.sku) },
    props: { product: p },
  }));
}

const { product } = Astro.props as { product: Product };
const catSlug = categorySlug(product.category);
const catName = categoryName(product.category);
const depth = skuDepth[skuSlug(product.url_slug || product.sku)];
const relatedGuides = (categoryGuides[catSlug] ?? [])
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter(Boolean);

// Related products: sibling SKUs in the same category (max 4), excluding self.
const relatedProducts = products
  .filter((p) => p.category === product.category && p.sku !== product.sku)
  .slice(0, 4);

const pillar = pillarForCategory(catSlug);
const isAutomotive = isAutomotiveCategory(catSlug);

const breadcrumbs = [
  { label: 'Products', href: '/products/' },
  { label: catName, href: `/products/${catSlug}/` },
  { label: product.sku, href: `/products/${catSlug}/${skuSlug(product.url_slug || product.sku)}/` },
];

// Confirmed spec entries only (drop any whose data_status is pending).
const confirmedSpec = product.spec.filter((s) => s.data_status !== 'pending');
const confirmedMaterial = product.material.filter((m) => m.data_status !== 'pending');
const confirmedMedia = product.filter_media.filter((m) => m.data_status !== 'pending');
const confirmedApplications = product.application.filter((a) => a.data_status !== 'pending');

// Six-block structure (carfilterspro audit paradigm):
// 1. Identity + inquiry · 2. Core params (confirmed only) · 3. OE cross-reference
// 4. Quality documents (real items only) · 5. OEM terms · 6. Related resources
// Entity associations mirror the on-page fields: material (media type), efficiency
// class, and spec values are exposed as Product `material` + `additionalProperty` so
// the structured data stays consistent with the body text (no fabricated values).
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `https://chinafilterhub.com/products/${catSlug}/${skuSlug(product.url_slug || product.sku)}/#product`,
  name: product.name,
  sku: product.sku,
  category: catName,
  description: product.description || undefined,
  brand: { '@type': 'Brand', name: site.brand },
  url: `https://chinafilterhub.com/products/${catSlug}/${skuSlug(product.url_slug || product.sku)}/`,
  material: confirmedMaterial.length > 0
    ? confirmedMaterial.map((m) => `${m.part}: ${m.material_value}`).join(', ')
    : undefined,
  additionalProperty: [
    ...(product.efficiency_class
      ? [{ '@type': 'PropertyValue', name: 'efficiency_class', value: product.efficiency_class }]
      : []),
    ...confirmedSpec.map((s) => ({
      '@type': 'PropertyValue',
      name: s.spec_key,
      value: `${s.spec_value}${s.unit ? ` ${s.unit}` : ''}`,
    })),
  ],
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    offerCount: 1,
    // Price on quotation — no fabricated price. Omit lowPrice/highPrice.
  },
};
---

<BaseLayout title={product.name} description={product.description || product.name} breadcrumbs={breadcrumbs}>
  <main class="wrap" style="padding-top:2rem;max-width:860px;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/products/">Products</a> /{' '}
      <a href={`/products/${catSlug}/`}>{catName}</a> / {product.sku}
    </nav>

    {/* 1. Identity + inquiry */}
    <section>
      <h1>{product.name}</h1>
      <p class="muted" style="margin-top:-0.4rem;">
        SKU <code>{product.sku}</code> · <a href={`/products/${catSlug}/`}>{catName}</a> · <StatusBadge status={product.data_status} />
      </p>
      {product.description && <p class="lede">{product.description}</p>}
      <p class="notice">
        This is a catalogue reference entry, not a verified fitment. Request a quotation with the
        SKU or OE number and confirm the spec sheet before ordering.
      </p>
      <p style="margin-top:1rem;">
        <a class="btn btn-primary" href="/rfq/">Request quotation for {product.sku} →</a>
        <a class="btn btn-ghost" href="/contact/" style="margin-left:0.5rem;">Other channels</a>
      </p>
    </section>

    {/* 2. Core parameters — confirmed fields only */}
    <section class="section">
      <h2 class="mt-0">Core parameters</h2>
      {confirmedSpec.length > 0 ? (
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">Parameter</th>
                <th scope="col">Value</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {confirmedSpec.map((s) => (
                <tr>
                  <td><code>{s.spec_key}</code></td>
                  <td>{s.spec_value}{s.unit ? ` ${s.unit}` : ''}</td>
                  <td><StatusBadge status={s.data_status} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="muted">
          Technical parameters for this SKU are listed in the specification table above.
        </p>
      )}
      {product.efficiency_class && (
        <p style="margin-top:0.75rem;">
          Efficiency class: <code>{product.efficiency_class}</code>
        </p>
      )}
      {confirmedMedia.length > 0 && (
        <p style="margin-top:0.75rem;">
          Filter media: {confirmedMedia.map((m) => (m.efficiency_class ? `${m.type} (${m.efficiency_class})` : m.type)).join(' · ')}
        </p>
      )}
      {confirmedMaterial.length > 0 && (
        <p style="margin-top:0.5rem;">
          Material / construction:{' '}
          {confirmedMaterial.map((m) => `${m.part}: ${m.material_value}`).join(' · ')}
        </p>
      )}
      {confirmedApplications.length > 0 && (
        <p style="margin-top:0.5rem;">
          Application: {confirmedApplications.map((a) => `${a.medium}${a.code ? ` (${a.code})` : ''}`).join(' · ')}
        </p>
      )}
    </section>

    {/* 3. OE cross-reference */}
    <section class="section">
      <h2 class="mt-0">OE cross-reference</h2>
      {product.oe_reference.length > 0 ? (
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">OE number</th>
                <th scope="col">Brand</th>
                <th scope="col">Equipment</th>
              </tr>
            </thead>
            <tbody>
              {product.oe_reference.map((o) => (
                <tr>
                  <td><code>{o.oe_number}</code></td>
                  <td>{o.brand ?? '—'}</td>
                  <td>{o.equipment_type ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="muted">No OE cross-reference published for this SKU.</p>
      )}
      <p class="muted small" style="margin-top:0.5rem;">
        A cross-reference links a part to an OE number; it does not by itself confirm the
        dimensional match. Verify against the OE drawing before bulk ordering.
      </p>
    </section>

    {/* 4. Quality documents — real items only */}
    <section class="section">
      <h2 class="mt-0">Quality documents</h2>
      <p class="muted">
        Quality certificates (leakage-test report, media-efficiency test) are issued per order;
        request the applicable test report at inquiry.
      </p>
    </section>

    {depth && (
      <section class="section">
        <h2 class="mt-0">Fitment &amp; sourcing</h2>
        <p>{depth.fitment}</p>
        <p style="margin-top:0.5rem;">{depth.conclusion}</p>
      </section>
    )}

    {/* 5. OEM terms */}
    <section class="section">
      <h2 class="mt-0">OEM / private-label terms</h2>
      {product.moq.moq_value !== null ? (
        <p>
          Published MOQ: <code>{product.moq.moq_value} {product.moq.moq_unit}</code>{' '}
          <StatusBadge status={product.moq.data_status} />
        </p>
      ) : (
        <p class="muted">MOQ not published for this SKU — quoted per line at inquiry.</p>
      )}
      <p class="muted">
        Custom sizing and private-label packaging are available under OEM/ODM terms; confirm
        dimensions, marking and packaging with the supplier.{' '}
        <a href="/oem/">See the OEM process</a>.
      </p>
    </section>

    {/* 6. Related products & guides (Phase 5 template) */}
    {relatedProducts.length > 0 && (
      <section class="section">
        <h2 class="mt-0">Related products</h2>
        <p class="muted small">Other catalogue SKUs in {catName}.</p>
        <ul>
          {relatedProducts.map((p) => (
            <li>
              <a href={`/products/${catSlug}/${skuSlug(p.url_slug || p.sku)}/`}>
                <code>{p.sku}</code> — {p.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedGuides.length > 0 && (
      <section class="section">
        <h2 class="mt-0">Related guides</h2>
        <ul>
          {relatedGuides.map((g) => (
            <li><a href={`/guides/${g!.slug}/`}>{g!.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {/* 7. Related resources */}
    <section class="section">
      <h2 class="mt-0">Related resources</h2>
      <ul>
        {pillar && (
          <li>
            Pillar: <a href={`/pillars/${pillar.slug}/`}>{pillar.name}</a>
          </li>
        )}
        <li>
          Category overview: <a href={`/products/${catSlug}/`}>{catName}</a>
        </li>
        {isAutomotive && (
          <li>
            Manufacturer: <a href="/company/">Qinghe Huiying manufacturing</a> ·{' '}
            <a href="/factory/">factory &amp; quality control</a>
          </li>
        )}
        <li>
          Machine-readable record:{' '}
          <a href={`${site.dataSubsiteUrl}/products/${skuSlug(product.sku)}/`} rel="noopener" target="_blank">
            data subsite SKU page
          </a>
        </li>
      </ul>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </main>
</BaseLayout>
