---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { categories, type Category } from '../../data/categories';
import { guides } from '../../data/guides';
import { categoryGuides } from '../../data/link-map';
import { site } from '../../data/site';
import { productsByCategory, skuSlug, codeFromSlug } from '../../data/products';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props as { category: Category };
const code = codeFromSlug(category.slug);
const skus = productsByCategory(code);
const relatedGuides = (categoryGuides[category.slug] ?? [])
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter(Boolean);
const breadcrumbs = [
  { label: 'Products', href: '/products/' },
  { label: category.name, href: `/products/${category.slug}/` },
];

// Distinct efficiency labels and material values actually present in this category's SKUs.
const effLabels = [...new Set(skus.map((p) => p.efficiency_class).filter(Boolean))];
const materials = [
  ...new Set(skus.flatMap((p) => p.material.map((m) => m.material_value)).filter(Boolean)),
];
const applications = [
  ...new Set(skus.flatMap((p) => p.application.map((a) => a.medium)).filter(Boolean)),
];

// Representative imagery for the six main category pages (industrial, text-free).
const categoryImages: Record<string, { src: string; alt: string }> = {
  'air-filters': {
    src: '/images/ai/category-air-filters.webp',
    alt: 'Pleated panel engine air filter cartridge with white synthetic media in a metal frame',
  },
  'hepa-filters': {
    src: '/images/ai/category-hepa-filters.webp',
    alt: 'Folded pleated HEPA filter element with dense white micro-glass media',
  },
  'pocket-filters': {
    src: '/images/ai/category-pocket-filters.webp',
    alt: 'Row of white fabric filter bags in a metal air-handling frame',
  },
  'cleanroom-equipment': {
    src: '/images/ai/category-cleanroom-equipment.webp',
    alt: 'Cleanroom fan filter unit ceiling module with a stainless steel laminar flow panel',
  },
  'oil-filters': {
    src: '/images/ai/category-oil-filters.webp',
    alt: 'Spin-on oil filter canister with ribbed metal body and rubber gasket',
  },
  'filter-media': {
    src: '/images/ai/category-filter-media.webp',
    alt: 'Macro view of a non-woven filter media fibre web',
  },
};
const catImage = categoryImages[category.slug];
---

<BaseLayout title={category.name} description={category.summary} breadcrumbs={breadcrumbs}>
  <main class="wrap" style="padding-top:2rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/products/">Products</a> / {category.name}
    </nav>
    <h1>{category.name}</h1>
    <p class="muted" style="margin-top:-0.4rem;">{category.nameZh} · <code>{category.grades}</code></p>

    {category.subcategories.length > 0 && (
      <p style="margin-top:1rem;">
        <strong>Sub-categories:</strong> {category.subcategories.join(' · ')}
      </p>
    )}

    {catImage && (
      <figure style="margin:1.5rem 0 0;">
        <img
          src={catImage.src}
          alt={catImage.alt}
          width="1200"
          height="675"
          loading="lazy"
          style="width:100%;height:auto;border-radius:var(--radius-lg);border:1px solid var(--line);display:block;"
        />
      </figure>
    )}

    {/* At-a-glance comparison table */}
    <section class="section">
      <h2 class="mt-0">Category at a glance</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Attribute</th>
              <th scope="col">Value</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Efficiency framework</strong></td>
              <td><code>{category.grades}</code></td>
            </tr>
            {category.subcategories.length > 0 && (
              <tr>
                <td><strong>Sub-categories</strong></td>
                <td>{category.subcategories.join(' · ')}</td>
              </tr>
            )}
            <tr>
              <td><strong>SKUs catalogued</strong></td>
              <td>{skus.length}</td>
            </tr>
            {effLabels.length > 0 && (
              <tr>
                <td><strong>Efficiency grades seen</strong></td>
                <td>{effLabels.map((e) => <code>{e}</code>).reduce((a, b) => <>{a} · {b}</>)}</td>
              </tr>
            )}
            {materials.length > 0 && (
              <tr>
                <td><strong>Materials / construction</strong></td>
                <td>{materials.join(' · ')}</td>
              </tr>
            )}
            {applications.length > 0 && (
              <tr>
                <td><strong>Application medium</strong></td>
                <td>{applications.map((a) => <code>{a}</code>).reduce((a, b) => <>{a} · {b}</>)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Positioning</h2>
      <p>{category.positioning}</p>
    </section>

    <section>
      <h2>What it is</h2>
      <p>{category.directAnswer}</p>
    </section>

    <section>
      <h2>Technical depth</h2>
      <p>{category.technicalDepth}</p>
    </section>

    <section>
      <h2>Selection guidance</h2>
      <ul>
        {category.selection.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section>
      <h2>Procurement notes</h2>
      <ul>
        {category.procurement.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section>
      <h2>From a sourcing perspective</h2>
      <p>{category.sourcingPerspective}</p>
    </section>

    {relatedGuides.length > 0 && (
      <section class="section">
        <h2 class="mt-0">Related buyer guides</h2>
        <ul>
          {relatedGuides.map((g) => (
            <li><a href={`/guides/${g!.slug}/`}>{g!.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {skus.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2 class="mt-0">SKUs in this category ({skus.length})</h2>
          <p class="muted small">Cross-references are discovery aids, not verified fitments.</p>
        </div>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">SKU</th>
                <th scope="col">Name</th>
                <th scope="col">Efficiency</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {skus.map((p) => (
                <tr>
                  <td>
                    <a href={`/products/${category.slug}/${skuSlug(p.sku)}/`}><code>{p.sku}</code></a>
                  </td>
                  <td>
                    <a href={`/products/${category.slug}/${skuSlug(p.sku)}/`} style="color:var(--ink);">
                      {p.name}
                    </a>
                  </td>
                  <td>{p.efficiency_class ? <code>{p.efficiency_class}</code> : <span class="muted">—</span>}</td>
                  <td><StatusBadge status={p.data_status} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <p class="notice" style="margin-top:1.5rem;">
      Per-model dimensions, pressure drop, dust-holding capacity and other unpublished fields are
      marked <code>pending</code> in the{' '}
      <a href={`${site.dataSubsiteUrl}/products/${category.slug}/`} rel="noopener" target="_blank">data subsite</a>{' '}
      rather than estimated.
    </p>
  </main>
</BaseLayout>
