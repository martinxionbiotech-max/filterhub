---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { categories } from '../../data/categories';
import { categoryCount, totalProducts } from '../../data/products';

const breadcrumbs = [{ label: 'Products', href: '/products/' }];
---

<BaseLayout
  title="Product Centre"
  description="Thirteen filter categories across engine filtration, HVAC/cleanroom air filtration and liquid/metal cartridges, mapped to a single efficiency-grade framework."
  breadcrumbs={breadcrumbs}
>
  <main class="wrap" style="padding-top:2rem;">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / Products</nav>
    <h1>Product Centre</h1>
    <p class="lede" style="max-width:70ch;">
      Thirteen categories organised as a category-to-SKU tree ({totalProducts} SKUs total). Each
      category is anchored to a recognised efficiency-grade framework so specifications stay
      comparable across the range.
    </p>

    <div class="grid grid--cards" style="margin-top:1.75rem;">
      {categories.map((c) => {
        const count = categoryCount(c.slug);
        return (
          <a class="card card--link category-card" href={`/products/${c.slug}/`}>
            <span class="category-count">{count} SKU{count === 1 ? '' : 's'}</span>
            <span class="category-icon" aria-hidden="true"><CategoryIcon slug={c.slug} /></span>
            <span class="category-body">
              <strong class="category-name">{c.name}</strong>
              <span class="muted small category-summary">{c.summary}</span>
              {c.subcategories.length > 0 && (
                <span class="smaller category-subs">{c.subcategories.join(' · ')}</span>
              )}
            </span>
          </a>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-height: 9.5rem;
    padding: 1.05rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .category-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--orange-300);
  }
  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--navy-50);
    color: var(--navy-700);
  }
  .category-card:hover .category-icon { background: var(--orange-50); color: var(--orange-600); }
  .category-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .category-name { color: var(--navy-800); font-size: 0.98rem; }
  .category-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
    line-height: 1.25;
  }
  .category-subs {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--muted);
  }
  .category-count {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--navy-600);
    background: var(--navy-50);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    white-space: nowrap;
  }
  .category-card:hover .category-count { background: var(--orange-50); color: var(--orange-700); }
</style>
