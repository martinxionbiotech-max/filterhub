---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { site } from '../data/site';
import { categories } from '../data/categories';
import { categoryCount, totalProducts, coveredCategories } from '../data/products';

const totalCategories = categories.length;
---

<BaseLayout
  title="Air, oil, fuel, hydraulic and cleanroom filtration"
  description="Qinghe Yinghui Filter consolidates a full-span filter catalogue — engine intake, oil, fuel, hydraulic, HVAC, HEPA/ULPA, activated carbon and cleanroom equipment — under one sourcing relationship."
>
  <section class="hero">
    <img
      class="hero-bg"
      src="/images/ai/hero-filtration.webp"
      alt="Pleated air filter with orange airflow particles streaming through the folds against a deep navy background"
      width="1600"
      height="900"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow eyebrow--on-dark">Filter manufacturer &amp; exporter</p>
      <h1 style="max-width:20ch;margin-top:0.35rem;">
        Air, oil, fuel, hydraulic and cleanroom filtration — one Qinghe Yinghui-based manufacturing partner
      </h1>
      <p class="lede" style="max-width:62ch;">
        Qinghe Yinghui Filter consolidates a full-span filter catalogue under a single sourcing
        relationship. Engine intake air, cabin, oil, fuel, hydraulic and transmission filters sit
        alongside HVAC, HEPA/ULPA, activated-carbon and cleanroom-grade equipment, so a buyer
        carrying several categories no longer has to split orders across multiple suppliers.
      </p>
      <p style="margin-top:1.5rem;">
        <a class="btn btn-primary" href="/products/">Browse the catalogue</a>
        <a class="btn btn-ghost" href="/guides/" style="margin-left:0.5rem;background:rgba(255,255,255,0.06);color:#fff;border-color:rgba(255,255,255,0.25);">Buyer guides</a>
      </p>
    </div>
  </section>

  <main class="wrap">
    {/* Strength data cards */}
    <section class="grid grid--stats" style="margin-top:-2rem;position:relative;">
      <div class="card"><p class="muted small mb-0">Total SKUs</p><p class="stat" style="font-size:2rem;font-weight:800;color:var(--navy-800);margin:0.1rem 0 0;">{totalProducts}</p></div>
      <div class="card"><p class="muted small mb-0">Categories covered</p><p class="stat" style="font-size:2rem;font-weight:800;color:var(--navy-800);margin:0.1rem 0 0;">{coveredCategories}<span class="muted" style="font-size:1.1rem;font-weight:600;"> / {totalCategories}</span></p></div>
      <div class="card"><p class="muted small mb-0">Efficiency framework</p><p class="stat" style="font-size:1.35rem;font-weight:800;color:var(--navy-800);margin:0.35rem 0 0;">ISO · EN · MERV</p></div>
      <div class="card"><p class="muted small mb-0">Data discipline</p><p class="stat" style="font-size:1.35rem;font-weight:800;color:var(--navy-800);margin:0.35rem 0 0;">4 status labels</p></div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2 class="mt-0">Category entry</h2>
        <p class="muted">All specifications carry a per-field data-status label.</p>
      </div>
      <div class="grid grid--cards">
        {categories.map((c) => {
          const count = categoryCount(c.slug);
          return (
            <a class="card card--link category-card" href={`/products/${c.slug}/`}>
              <span class="category-icon" aria-hidden="true"><CategoryIcon slug={c.slug} /></span>
              <span class="category-body">
                <strong class="category-name">{c.name}</strong>
                <span class="muted small" style="display:block;margin-top:0.2rem;">{c.summary}</span>
              </span>
              <span class="category-count">
                {count} SKU{count === 1 ? '' : 's'}
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section" style="max-width:820px;">
      <h2 class="mt-0">Five questions</h2>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
        <div class="card"><h3>Who are you?</h3><p class="muted small mb-0">A filter manufacturer and exporter positioned in the Qinghe filter industry cluster of Hebei province. Entity and registration details are disclosed on the company page.</p></div>
        <div class="card"><h3>What do you make?</h3><p class="muted small mb-0">Thirteen product categories spanning engine filtration, HVAC/cleanroom air filtration and liquid/metal cartridges, mapped to a recognised efficiency-grade framework.</p></div>
        <div class="card"><h3>Why choose you?</h3><p class="muted small mb-0">A consolidated catalogue reduces supplier count. Specifications are comparable across the range, with custom sizing and OEM/private-label support.</p></div>
        <div class="card"><h3>How do you guarantee quality?</h3><p class="muted small mb-0">Every specification carries a per-field data-status label (verified / catalog-confirmed / reference / pending). The data subsite holds the machine-readable record.</p></div>
        <div class="card"><h3>How do we start?</h3><p class="muted small mb-0">Send an inquiry with the SKU or OE number, or a drawing and target quantity. MOQ and lead time are quoted per line; indicative pricing is confirmed on quotation.</p></div>
      </div>
    </section>

    <section class="section" style="max-width:820px;">
      <h2 class="mt-0">Strength</h2>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr><th>Capability</th><th>What it means for buyers</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Consolidated range</strong></td><td>One relationship across engine, HVAC, cleanroom and liquid filtration.</td></tr>
            <tr><td><strong>Grade-standardised</strong></td><td>Every air-filtration category is anchored to a recognised efficiency class.</td></tr>
            <tr><td><strong>Traceable data</strong></td><td>Each specification field carries a data-status tag so the catalogue stays comparable across the range.</td></tr>
            <tr><td><strong>Custom and OEM</strong></td><td>Standard and custom sizes, with OEM/ODM support.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="notice" style="margin-top:1.25rem;">
        Entity disclosure: the operating legal entity, registration details, factory address and
        contact channels are shown on the{' '}
        <a href="/company/">company page</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(8, 29, 48, 0.9) 0%, rgba(15, 42, 67, 0.82) 55%, rgba(22, 58, 92, 0.7) 100%);
  }
  .hero .wrap { position: relative; z-index: 1; }
  .category-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .category-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--navy-50);
    color: var(--navy-700);
  }
  .category-card:hover .category-icon { background: var(--orange-50); color: var(--orange-600); }
  .category-body { flex: 1 1 auto; min-width: 0; }
  .category-name { color: var(--navy-800); }
  .category-count {
    flex: 0 0 auto;
    align-self: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--navy-600);
    background: var(--navy-50);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    white-space: nowrap;
  }
  .category-card:hover .category-count { background: var(--orange-50); color: var(--orange-700); }
</style>
