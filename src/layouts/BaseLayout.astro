---
import { site, nav, complianceLinks, organizationSchema } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: { label: string; href: string }[];
}

const { title, description, breadcrumbs = [] } = Astro.props;

// Meta descriptions are truncated to ~155 chars (word boundary) for length
// compliance; the full text stays on-page. Intent keywords lead the sentence
// set, so truncation never drops them.
function truncateDesc(text: string, max = 155): string {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const at = cut.lastIndexOf(' ');
  return (at > max * 0.6 ? cut.slice(0, at) : cut).trimEnd() + '…';
}

const metaDescription = truncateDesc(description);

const canonical = new URL(Astro.url.pathname, site.siteUrl).toString();
const ogImage = `${site.siteUrl}/images/og-default.svg`;

const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl + '/' },
        ...breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: b.label,
          item: new URL(b.href, site.siteUrl).toString(),
        })),
      ],
    }
  : null;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description: metaDescription,
  isPartOf: { '@id': `${site.siteUrl}/#website` },
  publisher: { '@id': `${site.siteUrl}/#organization` },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.siteUrl}/#website`,
  url: site.siteUrl,
  name: site.brand,
  publisher: { '@id': `${site.siteUrl}/#organization` },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.brand}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <style is:global>
      /* ============================================================
         FilterHub design system — B2B industrial
         Deep navy #0F2A43 × industrial orange #E8622C
         ============================================================ */
      :root {
        /* Brand */
        --navy-900: #081d30;
        --navy-800: #0f2a43;
        --navy-700: #163a5c;
        --navy-600: #1e4a73;
        --navy-100: #e3ebf2;
        --navy-50: #f0f4f8;

        --orange-600: #e8622c;
        --orange-500: #f0703a;
        --orange-700: #c94f1f;
        --orange-100: #fde7db;
        --orange-50: #fef3ec;

        /* Semantic */
        --ink: #122236;
        --muted: #55677a;
        --line: #e2e8f0;
        --bg: #f7f9fb;
        --surface: #ffffff;

        /* Data-status badges */
        --verified: #0b6e4f;
        --verified-bg: #e6f4ee;
        --catalog-confirmed: #0e7490;
        --catalog-confirmed-bg: #e0f2f7;
        --reference: #b45309;
        --reference-bg: #fbeeda;
        --pending: #64748b;
        --pending-bg: #eef1f5;

        /* Typography scale */
        --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: ui-monospace, "SFMono-Regular", "SF Mono", Menlo, Consolas, monospace;
        --fs-h1: clamp(1.9rem, 4.2vw, 2.6rem);
        --fs-h2: clamp(1.35rem, 2.6vw, 1.65rem);
        --fs-h3: 1.08rem;
        --fs-body: 1rem;
        --fs-sm: 0.9rem;
        --fs-xs: 0.8rem;
        --lh-tight: 1.18;
        --lh-body: 1.68;

        /* Spacing scale (8pt-ish) */
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.25rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;

        /* Shape & elevation */
        --radius-sm: 6px;
        --radius-md: 10px;
        --radius-lg: 14px;
        --shadow-sm: 0 1px 2px rgba(8, 29, 48, 0.06);
        --shadow-md: 0 4px 14px rgba(8, 29, 48, 0.09);
        --shadow-lg: 0 10px 30px rgba(8, 29, 48, 0.14);
      }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--ink);
        background: var(--surface);
        line-height: var(--lh-body);
        font-size: var(--fs-body);
        -webkit-font-smoothing: antialiased;
      }

      /* ---- Headings — single-H1 discipline, no level skips ---- */
      h1, h2, h3, h4 { line-height: var(--lh-tight); color: var(--navy-800); margin: 0 0 0.6em; font-weight: 700; }
      h1 { font-size: var(--fs-h1); letter-spacing: -0.02em; }
      h2 { font-size: var(--fs-h2); margin-top: 2.2em; letter-spacing: -0.01em; }
      h3 { font-size: var(--fs-h3); margin-top: 1.6em; }
      p { margin: 0 0 1em; }
      ul, ol { padding-left: 1.35rem; }
      li { margin: 0.3rem 0; }

      a { color: var(--orange-600); text-decoration: none; }
      a:hover { color: var(--orange-700); text-decoration: underline; }

      code {
        font-family: var(--font-mono);
        font-size: 0.88em;
        background: var(--navy-50);
        color: var(--navy-700);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        white-space: nowrap;
      }

      /* ---- Layout primitives ---- */
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem; }
      .wrap-wide { max-width: 1240px; margin: 0 auto; padding: 0 1.25rem; }
      .stack { display: grid; gap: 1rem; }
      .muted { color: var(--muted); }
      .small { font-size: var(--fs-sm); }
      .smaller { font-size: var(--fs-xs); }

      .eyebrow {
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        font-size: 0.74rem;
        font-weight: 700;
        color: var(--orange-600);
      }
      .eyebrow--on-dark { color: #f6a07c; }

      .lede { font-size: 1.12rem; color: var(--muted); line-height: 1.65; }

      .breadcrumb {
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0.5rem 0 1.25rem;
      }
      .breadcrumb a { color: var(--muted); }
      .breadcrumb a:hover { color: var(--orange-600); }

      /* ---- Section shell ---- */
      .section { margin-top: var(--space-10); }
      .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
      .section-head h2 { margin: 0; }
      .section-head .muted { margin: 0; }

      /* ---- Callouts ---- */
      .notice {
        border-left: 4px solid var(--orange-600);
        background: var(--orange-50);
        padding: 0.85rem 1.05rem;
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        font-size: 0.94rem;
        color: #5b3a22;
      }
      .notice--navy {
        border-left-color: var(--navy-600);
        background: var(--navy-50);
        color: var(--navy-700);
      }

      /* ---- Buttons ---- */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.15rem;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
        text-decoration: none;
      }
      .btn:hover { text-decoration: none; }
      .btn-primary { background: var(--orange-600); color: #fff; }
      .btn-primary:hover { background: var(--orange-700); color: #fff; transform: translateY(-1px); }
      .btn-navy { background: var(--navy-800); color: #fff; }
      .btn-navy:hover { background: var(--navy-700); color: #fff; }
      .btn-ghost { background: transparent; color: var(--navy-800); border-color: var(--line); }
      .btn-ghost:hover { border-color: var(--orange-600); color: var(--orange-600); }

      /* ---- Cards ---- */
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        box-shadow: var(--shadow-sm);
      }
      .card--link {
        display: block;
        color: var(--ink);
        text-decoration: none;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
      }
      .card--link:hover {
        border-color: var(--orange-600);
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
        text-decoration: none;
        color: var(--ink);
      }

      /* Responsive card grids: 4 → 2 → 1 */
      .grid { display: grid; gap: 1rem; }
      .grid--cards { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
      .grid--stats { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

      /* ---- Data-status badges ---- */
      .badge {
        display: inline-block;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.5;
        white-space: nowrap;
        vertical-align: middle;
      }
      .badge--verified { background: var(--verified-bg); color: var(--verified); }
      .badge--catalog-confirmed { background: var(--catalog-confirmed-bg); color: var(--catalog-confirmed); }
      .badge--reference { background: var(--reference-bg); color: var(--reference); }
      .badge--pending { background: var(--pending-bg); color: var(--pending); }

      /* ---- Tables ---- */
      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--line); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
      table.data {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.94rem;
        min-width: 480px;
      }
      table.data caption { caption-side: top; text-align: left; padding: 0.8rem 1rem; font-weight: 600; color: var(--navy-800); background: var(--navy-50); border-bottom: 1px solid var(--line); }
      table.data thead th {
        text-align: left;
        padding: 0.7rem 1rem;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        background: var(--bg);
        border-bottom: 2px solid var(--line);
        white-space: nowrap;
      }
      table.data tbody td {
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      table.data tbody tr:last-child td { border-bottom: none; }
      table.data tbody tr:hover { background: var(--navy-50); }
      table.data td.num, table.data th.num { text-align: right; font-variant-numeric: tabular-nums; }

      /* ---- Hero (homepage) ---- */
      .hero {
        background: linear-gradient(160deg, var(--navy-900) 0%, var(--navy-800) 55%, var(--navy-700) 100%);
        color: #eaf1f7;
        padding: 3.5rem 0 4.5rem;
        border-bottom: 4px solid var(--orange-600);
      }
      .hero h1 { color: #fff; }
      .hero .lede { color: #c4d3e2; }
      .hero a { color: #f6a07c; }

      /* ---- Table of contents (guide pages) ---- */
      .toc {
        background: var(--navy-50);
        border: 1px solid var(--line);
        border-left: 4px solid var(--orange-600);
        border-radius: var(--radius-md);
        padding: 1rem 1.25rem;
      }
      .toc ol { margin: 0.5rem 0 0; padding-left: 1.3rem; }
      .toc li { margin: 0.35rem 0; }
      .toc a { color: var(--navy-700); }
      .toc a:hover { color: var(--orange-600); }

      /* ---- Utility ---- */
      .mt-0 { margin-top: 0 !important; }
      .mb-0 { margin-bottom: 0 !important; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }

      /* ---- Responsive ---- */
      @media (max-width: 720px) {
        .wrap, .wrap-wide { padding: 0 1rem; }
        .hero { padding: 2.5rem 0 3rem; }
        .section { margin-top: var(--space-8); }
        table.data { min-width: 420px; }
      }
    </style>
  </head>
  <body>
    <Header />
    <slot />
    <Footer site={site} complianceLinks={complianceLinks} />
  </body>
</html>
