---
import { site, nav } from '../data/site';

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap-wide header-inner">
    <a href="/" class="brand" aria-label={`${site.brand} — home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 4h18v16H3z" />
          <path d="M3 9h18" />
          <path d="M7 4v5" />
          <path d="M12 4v5" />
          <path d="M17 4v5" />
          <path d="M5 14l4 4 10-10" />
        </svg>
      </span>
      <span class="brand-text">{site.brand}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((n) => (
          <li>
            <a
              href={n.href}
              class:list={['nav-link', { 'nav-link--active': isActive(n.href) }]}
              aria-current={isActive(n.href) ? 'page' : undefined}
            >
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    font-size: 1.12rem;
    color: var(--navy-800);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand:hover { text-decoration: none; color: var(--navy-800); }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--navy-800);
    color: var(--orange-500);
  }
  .primary-nav ul {
    list-style: none;
    display: flex;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.92rem;
    padding: 0.3rem 0.1rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover { color: var(--orange-600); text-decoration: none; }
  .nav-link--active {
    color: var(--orange-600);
    border-bottom-color: var(--orange-600);
  }

  @media (max-width: 720px) {
    .header-inner { flex-direction: column; align-items: flex-start; }
    .primary-nav ul { gap: 0.85rem; }
  }
</style>
