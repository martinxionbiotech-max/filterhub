---
interface Props {
  slug: string;
}

const { slug } = Astro.props;

// Minimal 24×24 line icons keyed by category slug. Fallback = generic filter glyph.
const paths: Record<string, string> = {
  'air-filters': '<path d="M3 8h18v8H3z"/><path d="M3 11h18"/><path d="M6 8v3M11 8v3M16 8v3"/>',
  'cabin-filters': '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 18v2M17 18v2M5 11h14"/>',
  'oil-filters': '<path d="M12 3s5 6 5 10a5 5 0 0 1-10 0c0-4 5-10 5-10z"/><path d="M12 14a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>',
  'fuel-filters': '<path d="M6 3h8l4 5v13H6z"/><path d="M18 8h2v2M10 12h5"/>',
  'hydraulic-filters': '<circle cx="8" cy="8" r="4"/><circle cx="16" cy="16" r="4"/><path d="M11 11l2 2"/>',
  'transmission-filters': '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>',
  'hvac-filters': '<path d="M12 3v18M3 12h18M12 3c4 2.5 4 15.5 0 18M12 3c-4 2.5-4 15.5 0 18"/>',
  'hepa-filters': '<path d="M12 3l8 4v6c0 5-3.5 8-8 8s-8-3-8-8V7z"/><path d="M9 12l2 2 4-4"/>',
  'activated-carbon': '<path d="M12 3l7 4v6l-7 4-7-4V7z"/><path d="M12 3v14M5 7l7 4 7-4"/>',
  'pocket-filters': '<path d="M3 5h18l-9 8z"/><path d="M3 5l9 8 9-8M12 13v8"/>',
  'filter-media': '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 10h18M3 14h18M8 5v14M16 5v14"/>',
  'liquid-cartridges': '<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 4v-2h6v2M5 12h14"/>',
  'cleanroom-equipment': '<rect x="4" y="6" width="16" height="14" rx="1"/><path d="M4 11h16M8 6v14M16 6v14"/>',
};

const fallback = '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 4v5M12 4v5M17 4v5"/>';
const markup = paths[slug] ?? fallback;
---

<svg
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>
